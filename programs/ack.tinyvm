# Ackermann's function, computed recursively.
#
#   A(m, n) = n + 1                    if m == 0
#   A(m, n) = A(m - 1, 1)              if m > 0 and n == 0
#   A(m, n) = A(m - 1, A(m, n - 1))    if m > 0 and n > 0
#
# Inputs are read from the stack as (m, n) with n on top, and the single
# result is left on the stack.
#
# Calling convention: `ack` takes m in r1 and n in r2, and leaves its result
# in r9. Registers are global, so a recursive call clobbers all three; the
# only value that must outlive one is m, which is spilled to the value stack
# for exactly the duration of the inner call. Keeping arguments and results
# in registers lets the optimizer fuse the arithmetic into register-to-
# register superinstructions, which the jit inlines instead of calling out to
# a stack helper per op.
#
# Both recursive tails are jumps rather than calls, so only the inner
# A(m, n - 1) consumes call-stack depth.

# --- main (instruction 0) ---
# Unpack the inputs into the argument registers: n is on top, m beneath it.
pop r2
pop r1
call 5p
# Push the result and exit.
push r9
exit

# --- ack (instruction 5) ---
# Base case: if m == 0, the result is n + 1. (jump to instruction 23)
push r1
jiz 23p
# m > 0. If n == 0, the result is A(m - 1, 1). (jump to instruction 28)
push r2
jiz 28p

# m > 0 and n > 0: the result is A(m - 1, A(m, n - 1)).
# Spill m; the inner call clobbers r1.
push r1
# Inner call takes (m, n - 1). r1 already holds m, so only n changes.
push r2
push 1u64
sub
pop r2
call 5p
# Reclaim m, then build the outer call's arguments: (m - 1, inner result).
pop r1
push r9
pop r2
push r1
push 1u64
sub
pop r1
# Tail call: A(m - 1, inner result) is our result.
jmp 5p

# --- m == 0 (instruction 23): result is n + 1 ---
push r2
push 1u64
add
pop r9
ret

# --- n == 0 (instruction 28): result is A(m - 1, 1) ---
push r1
push 1u64
sub
pop r1
push 1u64
pop r2
jmp 5p
