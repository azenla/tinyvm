# Ackermann's function, computed recursively.
#
#   A(m, n) = n + 1                    if m == 0
#   A(m, n) = A(m - 1, 1)              if m > 0 and n == 0
#   A(m, n) = A(m - 1, A(m, n - 1))    if m > 0 and n > 0
#
# Inputs are read from the stack as (m, n) with n on top; the single result
# is left on the stack. Registers r1-r9 are global and are clobbered by
# recursive calls, so every value that must outlive a `call` is kept on the
# value stack (the call stack only holds return addresses).

# --- main (instruction 0) ---
# The two inputs already sit on the stack as (m, n) with n on top, which is
# exactly the calling convention `ack` expects. Invoke it, then exit with the
# result on the stack.
call 2p
exit

# --- ack (instruction 2) ---
# Pop the arguments: n is on top, m beneath it.
pop r2
pop r1
# Base case: if m == 0, the result is n + 1. (jump to instruction 21)
push r1
jiz 21p
# m > 0. If n == 0, the result is A(m - 1, 1). (jump to instruction 25)
push r2
jiz 25p
# m > 0 and n > 0: the result is A(m - 1, A(m, n - 1)).
# Save m on the stack so it survives the inner recursive call.
push r1
# Push the inner call's arguments and compute n - 1: A(m, n - 1).
push r1
push r2
push 1u64
sub
# Recurse. Afterwards the stack holds [saved_m, inner_result].
call 2p
# Reload the two values the recursion clobbered.
pop r3
pop r4
# Push the outer call's arguments and compute m - 1: A(m - 1, inner_result).
push r4
push 1u64
sub
push r3
# Tail call: A(m - 1, inner_result) becomes our result.
jmp 2p

# --- m == 0 (instruction 21): result is n + 1 ---
push r2
push 1u64
add
ret

# --- n == 0 (instruction 25): result is A(m - 1, 1) ---
push r1
push 1u64
sub
push 1u64
jmp 2p
